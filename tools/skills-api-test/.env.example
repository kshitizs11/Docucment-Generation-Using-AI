# Copy this file to .env and fill in a real key before running test_skills_api.py
# Get a key at: https://console.anthropic.com/settings/keys
#
# This must be a direct Anthropic API key. A gateway/proxy key (TrueFoundry, Bedrock,
# Azure OpenAI, etc.) will not work here — the skills-upload and code-execution
# container endpoints are Anthropic-native beta APIs, not standard chat completions.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Optional: override the model used for the test call
# ANTHROPIC_TEST_MODEL=claude-sonnet-4-5-20250929
