# Direct Anthropic API key -- required for every node that calls Claude.
# Paste your real value here yourself -- never share it in chat.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Model for cheap planning-stage calls (Planner/Research/Content/Layout -- no code execution)
ANTHROPIC_PLANNING_MODEL=claude-sonnet-4-6

# Model for the OfficeSkill node (code execution + skills container)
ANTHROPIC_OFFICE_SKILL_MODEL=claude-sonnet-4-6

# Optional: require this exact value as an `X-API-Key` header on /generate, /jobs/*.
# Leave blank for local development (no auth enforced -- current default behavior).
# Set this before another service calls this API over any network you don't fully
# trust. Note: setting this also breaks the bundled browser UI -- see app/auth.py.
SERVICE_API_KEY=
